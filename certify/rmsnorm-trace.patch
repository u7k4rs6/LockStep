+# ---------------------------------------------------------------------------
+# LockStep instrumentation. NOT upstream. Reverted by restoring the sibling
+# .lockstep-orig file.
+#
+# Records num_tokens at every RMSNorm launch, which is the exact quantity the
+# pre-fix block-size branch in csrc/libtorch_stable/layernorm_kernels.cu reads:
+#     const int max_block_size = (num_tokens < 256) ? 1024 : 256;
+# Scheduler step accounting is a proxy for this; this is the variable itself.
+#
+# Deliberately does nothing that touches the GPU: numel() and shape are host-side
+# metadata, the write is buffered, and there is no synchronize. The instrument
+# must not perturb the packing it exists to measure.
+# ---------------------------------------------------------------------------
+import atexit as _ls_atexit
+import os as _ls_os
+import time as _ls_time
+
+_LS_TRACE = _ls_os.environ.get("LOCKSTEP_RMSNORM_TRACE")
+_ls_handle = None
+_ls_calls = 0
+
+
+def _ls_record(kind: str, tensor) -> None:
+    global _ls_handle, _ls_calls
+    if not _LS_TRACE:
+        return
+    if _ls_handle is None:
+        _ls_handle = open(f"{_LS_TRACE}.{_ls_os.getpid()}", "a", buffering=1 << 20)
+        _ls_atexit.register(lambda: (_ls_handle.flush(), _ls_handle.close()))
+    hidden = tensor.shape[-1]
+    num_tokens = tensor.numel() // hidden
+    # The kernel compares (num_tokens < 256), so 256 itself selects the narrow
+    # block. Recorded raw; the predicate is applied when the trace is read.
+    _ls_handle.write(f"{_ls_time.time():.6f}\t{kind}\t{num_tokens}\t{hidden}\n")
+    _ls_calls += 1
+    if _ls_calls % 512 == 0:
+        _ls_handle.flush()
+
