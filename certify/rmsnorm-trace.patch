--- a/v1/worker/gpu/model_runner.py.lockstep-orig
+++ a/v1/worker/gpu/model_runner.py
@@ -118,6 +118,66 @@
 logger = init_logger(__name__)
 
 
+
+# ---------------------------------------------------------------------------
+# LockStep instrumentation. NOT upstream. Reverted by restoring the sibling
+# .lockstep-orig file.
+#
+# Records what the scheduler put into each forward pass: the per-request token
+# counts, and, the first time a request is seen, a hash of its prompt so the
+# same request can be identified across repeats (vLLM assigns a fresh req_id
+# every submission, so req_id alone cannot be matched across repeats).
+#
+# Written to a sibling of the RMSNorm trace rather than into it, so the existing
+# trace format and its reader are untouched. Host-side only: no GPU call, no
+# synchronize.
+# ---------------------------------------------------------------------------
+import atexit as _ls_atexit
+import hashlib as _ls_hashlib
+import os as _ls_os
+import time as _ls_time
+
+_LS_TRACE = _ls_os.environ.get("LOCKSTEP_RMSNORM_TRACE")
+_ls_sched_handle = None
+_ls_seen_reqs = set()
+_ls_steps = 0
+
+
+def _ls_record_sched(scheduler_output) -> None:
+    global _ls_sched_handle
+    if not _LS_TRACE:
+        return
+    if _ls_sched_handle is None:
+        _ls_sched_handle = open(f"{_LS_TRACE}.sched.{_ls_os.getpid()}", "a",
+                                buffering=1 << 20)
+        _ls_atexit.register(
+            lambda: (_ls_sched_handle.flush(), _ls_sched_handle.close()))
+    now = _ls_time.time()
+    for new in getattr(scheduler_output, "scheduled_new_reqs", ()) or ():
+        if new.req_id in _ls_seen_reqs:
+            continue
+        _ls_seen_reqs.add(new.req_id)
+        tokens = new.prompt_token_ids or []
+        digest = _ls_hashlib.sha1(
+            ",".join(str(t) for t in tokens).encode()).hexdigest()[:16]
+        _ls_sched_handle.write(f"{now:.6f}\tnew\t{new.req_id}\t{digest}\t"
+                               f"{len(tokens)}\n")
+    per = scheduler_output.num_scheduled_tokens
+    items = ",".join(f"{k}={v}" for k, v in sorted(per.items()))
+    _ls_sched_handle.write(
+        f"{now:.6f}\tstep\t{scheduler_output.total_num_scheduled_tokens}\t"
+        f"{len(per)}\t{items}\n")
+    global _ls_steps
+    _ls_steps += 1
+    # Flush every step. The server is stopped with SIGTERM, which does not run
+    # atexit handlers, so anything still buffered is lost. Flushing every 32
+    # steps was not enough: the last repeat of the last case is the final
+    # activity before teardown, and it sat entirely in the buffer, so that
+    # repeat appeared to have run 1 step instead of 26. One write per forward
+    # pass is a few microseconds against a step of milliseconds.
+    _ls_sched_handle.flush()
+
+
