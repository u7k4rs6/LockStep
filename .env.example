# Copy to .env. .env is gitignored; this file is not.

# Hugging Face token. Only needed if the pinned Qwen3-0.6B revision becomes
# gated. Read-only scope is sufficient; never use a write-scoped token here.
HF_TOKEN=

# Reduction order in MKL/OpenMP depends on thread count, so an unpinned thread
# count makes the fp64 reference itself nondeterministic. Reference generation
# asserts this is set and records it in env.lock.
OMP_NUM_THREADS=8
